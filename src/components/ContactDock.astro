---
import type { Lang } from '../data/site';
import { siteMeta } from '../data/site';

interface Props {
  lang: Lang;
  contact: {
    title: string;
    intro: string;
    linkedinLabel: string;
    githubLabel: string;
  };
}

const { lang, contact } = Astro.props;
---

<section class="contact-dock" id="contact" aria-labelledby="contact-title">
  <div class="contact-dock__copy">
    <span>04 / {lang === 'en' ? 'Contact' : 'Contacto'}</span>
    <h2 id="contact-title">{contact.title}</h2>
    <p>{contact.intro}</p>
  </div>

  <div class="contact-dock__links">
    <a href={siteMeta.linkedin} target="_blank" rel="noreferrer">
      <small>{contact.linkedinLabel}</small>
      <strong>linkedin.com/in/reymundotenorio</strong>
    </a>
    <a href={siteMeta.github} target="_blank" rel="noreferrer">
      <small>{contact.githubLabel}</small>
      <strong>github.com/reymundotenorio</strong>
    </a>
  </div>
</section>
