---
import type { Lang, TimelineItem } from '../data/site';

interface Props {
  lang: Lang;
  items: TimelineItem[];
  title: string;
  intro: string;
}

const { lang, items, title, intro } = Astro.props;
---

<section class="experience-timeline" id="experience" aria-labelledby="experience-title">
  <div class="section-heading">
    <span>01 / {lang === 'en' ? 'Career' : 'Trayectoria'}</span>
    <h2 id="experience-title">{title}</h2>
    <p>{intro}</p>
  </div>

  <div class="timeline-rail">
    {items.map((item, index) => (
      <article class:list={['timeline-item', index < 2 && 'timeline-item--current']}>
        <div class="timeline-item__date"><span>{item.period}</span><small>{item.signal}</small></div>
        <div class="timeline-item__role"><h3>{item.company}</h3><strong>{item.role}</strong></div>
        <p>{item.summary}</p>
      </article>
    ))}
  </div>
</section>
