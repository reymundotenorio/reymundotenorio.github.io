---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../data/site';
import { archiveFilters, archiveItems, content, missions, profileSignals, timelineItems } from '../data/site';
import ContactDock from './ContactDock.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import MissionControl from './MissionControl.astro';
import MissionPanel from './MissionPanel.astro';
import ProfileSignals from './ProfileSignals.astro';
import WorkArchive from './WorkArchive.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = content[lang];
---

<BaseLayout lang={lang} title={page.seoTitle} description={page.seoDescription}>
  <main class="portfolio" data-experience-root data-lang={lang}>
    <MissionControl lang={lang} hero={page.hero} labels={page.missions} missions={missions[lang]} />
    <section class="mission-panels" aria-label="Mission details">
      {missions[lang].map((mission, index) => <MissionPanel mission={mission} active={index === 0} />)}
    </section>
    <ExperienceTimeline items={timelineItems[lang]} title={page.experience.title} intro={page.experience.intro} />
    <ProfileSignals content={profileSignals[lang]} />
    <WorkArchive
      lang={lang}
      filters={archiveFilters[lang]}
      items={archiveItems}
      title={page.work.title}
      intro={page.work.intro}
      viewCase={page.work.viewCase}
    />
    <ContactDock lang={lang} contact={page.contact} />
  </main>

  <footer class="site-footer">
    <span>© 2026 Reymundo Tenorio</span>
    <span>{page.footer}</span>
  </footer>
</BaseLayout>
