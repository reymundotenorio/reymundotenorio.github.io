---
import type { Data } from '../types';
import Icon from './Icon.astro';
import{projectHref}from'../lib/project-path';
import ProjectImage from'./ProjectImage.astro';
interface Props { data: Data }
const { data } = Astro.props; const en=data.lang==='en';
const featured=['duepulse','studio-ivl','pouch','claris-health'].map(id=>data.projects.find(project=>project.id===id)!);
const subtitles = en ? ['Personal finance PWA','Mobile application, built from scratch','Shipping platform, from interface to integrations','Healthcare website'] : ['PWA de finanzas personales','Aplicación móvil, creada desde cero','Plataforma de envíos, de interfaz a integraciones','Sitio web de salud'];
---
<section class="work-story" id="work" aria-labelledby="work-title" data-scene>
  <div class="story-frame" data-story-frame>
    <div class="story-heading"><h2 id="work-title">{en ? 'Selected work' : 'Proyectos destacados'}</h2><div class="scene-mode" data-motion-controls hidden><label class="motion-setting"><input type="checkbox" data-motion checked /><span>{en ? 'Motion' : 'Movimiento'}</span></label></div></div>
    <div class="story-viewport" data-story-viewport>
      <div class="story-track" data-story-track>
        {featured.map((project,i)=><article class="story-panel" data-story-panel data-project={project.id} aria-labelledby={`story-${project.id}`}>
          <div class="panel-meta"><span><b>{String(i+1).padStart(2,'0')}</b> / 04</span><span>{project.year}</span></div>
          <h3 id={`story-${project.id}`}>{project.id==='studio-ivl' ? 'IVL Collective' : project.name}</h3><p class="panel-subtitle">{subtitles[i]}</p>
          <a href={projectHref(data.lang,project.id,'work')} class:list={['story-media',project.id==='studio-ivl' && 'story-media--phones']} aria-label={`${en ? 'View project' : 'Ver proyecto'}: ${project.name}`}>
            {project.id==='studio-ivl' ? project.media.slice(0,3).map(media=><ProjectImage media={media} loading="eager" sizes="(min-width:1000px) 24vw, 30vw"/>) : <ProjectImage media={project.media[0]} loading="eager"/>}
          </a>
          <div class="panel-caption"><span>{project.media[0].label}</span><a href={projectHref(data.lang,project.id,'work')}>{en ? 'Project details' : 'Ver proyecto'}<Icon name="arrow-up-right" /></a></div>
        </article>)}
      </div>
    </div>
    <div class="story-controls"><div class="story-buttons" data-story-buttons hidden><button class="icon-button" type="button" data-prev aria-label={en ? 'Previous project' : 'Proyecto anterior'} data-tooltip={en ? 'Previous' : 'Anterior'}><Icon name="arrow-up" turn="left" /></button><button class="icon-button" type="button" data-next aria-label={en ? 'Next project' : 'Siguiente proyecto'} data-tooltip={en ? 'Next' : 'Siguiente'}><Icon name="arrow-up" turn="right" /></button></div><div class="story-progress" aria-hidden="true">{featured.map((_,i)=><span data-progress class:list={[i===0&&'is-active']}></span>)}</div><a class="text-link" href="#archive">{en ? `All ${data.projects.length} projects` : `Los ${data.projects.length} proyectos`}<Icon name="arrow-up-right" /></a></div>
    <p class="sr-only" data-slide-announcement aria-live="polite"></p>
  </div>
</section>
