---
import type { Lang, Mission } from '../data/site';

interface Props {
  lang: Lang;
  hero: {
    name: string;
    role: string;
    summary: string;
    primaryCta: string;
    secondaryCta: string;
    suggestion: string;
    consoleCommand: string;
  };
  missions: Mission[];
  labels: {
    label: string;
    consoleTitle: string;
  };
}

const { lang, hero, missions, labels } = Astro.props;
const pagePath = lang === 'en' ? '/en/' : '/es/';
const alternateHref = lang === 'en' ? '/es/' : '/en/';
const alternateLabel = lang === 'en' ? 'ES' : 'EN';
const missionLinks = missions.filter((mission) => mission.id !== 'contact');
const navLinkLabels = lang === 'en'
  ? { experience: 'Experience', projects: 'Projects', credentials: 'Credentials' }
  : { experience: 'Experiencia', projects: 'Proyectos', credentials: 'Credenciales' };
---

<section class="mission-control" aria-labelledby="hero-title">
  <canvas class="mission-control__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="mission-control__field" aria-hidden="true">
    <span class="field-grid"></span>
    <span class="field-cross field-cross--left"></span>
    <span class="field-cross field-cross--right"></span>
  </div>

  <header class="mission-control__nav" aria-label={lang === 'en' ? 'Primary navigation' : 'Navegación principal'}>
    <a class="mission-control__brand" href={pagePath} aria-label={lang === 'en' ? 'RT · Reymundo Tenorio home' : 'RT · Inicio de Reymundo Tenorio'}>
      <span>RT</span>
      <i></i>
    </a>
    <nav class="mission-control__links" aria-label={lang === 'en' ? 'Portfolio sections' : 'Secciones del portfolio'}>
      <a href={`${pagePath}#experience`}>{navLinkLabels.experience}</a>
      <a href={`${pagePath}#work`}>{navLinkLabels.projects}</a>
      <a href={`${pagePath}#signals`}>{navLinkLabels.credentials}</a>
    </nav>
    <a class="mission-control__contact" href="#contact">
      <span>{hero.secondaryCta}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8" />
      </svg>
    </a>
    <a class="mission-control__lang" data-language-switch href={alternateHref} hreflang={alternateLabel.toLowerCase()} aria-label={lang === 'en' ? 'EN / ES · Cambiar a español' : 'ES / EN · Switch to English'}>
      <strong>{lang.toUpperCase()}</strong>
      <span>/</span>
      <span>{alternateLabel}</span>
    </a>
  </header>

  <div class="mission-control__copy">
    <p class="mission-control__status">
      <span></span>
      {labels.label}
    </p>
    <h1 id="hero-title" data-typewrite={hero.name}>
      <span class="sr-only">{hero.name}</span>
      {hero.name.split(' ').map((word, index) => <span class="name-line" aria-hidden="true" style={`--letters: ${word.length}; --delay: ${index * 600}ms`}><span>{word}</span><i></i></span>)}
    </h1>
    <p class="mission-control__role" data-autocomplete={hero.role}><span>{hero.role}</span></p>
    <p class="mission-control__suggestion"><span aria-hidden="true">↳</span> {hero.suggestion}</p>
    <p class="mission-control__summary">{hero.summary}</p>
    <div class="mission-control__actions">
      <a href="#experience" class="button button--primary">
        <span>{hero.primaryCta}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 12 4 4 8-8" />
        </svg>
      </a>
      <a href="#contact" class="button button--ghost">
        <span>{hero.secondaryCta}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
      </a>
    </div>
  </div>

  <div class="mission-control__map" aria-hidden="true">
    <svg class="mesh-map" viewBox="0 0 700 700">
      <path class="mesh-line" d="M42 408 C132 296 214 512 312 386 C412 256 512 398 656 234" />
      <path class="mesh-line" d="M26 482 C162 362 226 430 342 342 C458 254 528 286 684 178" />
      <path class="mesh-line" d="M66 554 C170 426 310 476 392 352 C476 226 560 248 672 126" />
      <path class="mesh-line mesh-line--dim" d="M104 250 C214 318 286 190 384 274 C494 368 556 330 664 386" />
      <path class="mesh-line mesh-line--dim" d="M82 342 C210 216 316 254 420 194 C500 150 590 164 684 94" />
      <path class="mesh-line mesh-line--amber" d="M46 448 C176 392 260 548 386 448 C494 360 558 484 676 424" />
      <path class="mesh-line mesh-line--amber" d="M118 604 C242 548 318 604 428 528 C536 454 604 548 688 504" />
      <circle class="mesh-dot mesh-dot--red" cx="158" cy="392" r="4" />
      <circle class="mesh-dot" cx="256" cy="478" r="3" />
      <circle class="mesh-dot" cx="354" cy="350" r="3" />
      <circle class="mesh-dot mesh-dot--red" cx="476" cy="270" r="4" />
      <circle class="mesh-dot" cx="566" cy="404" r="3" />
      <circle class="mesh-dot mesh-dot--red" cx="626" cy="188" r="4" />
    </svg>
    <span class="signal-core"></span>
    <span class="signal-orbit signal-orbit--one"></span>
    <span class="signal-orbit signal-orbit--two"></span>
    <span class="signal-orbit signal-orbit--three"></span>
  </div>

  <div class="mission-control__nodes" id="missions" aria-label="Mission map">
    {missionLinks.map((mission, index) => (
      <button
        class:list={['mission-node', index === 0 && 'is-active']}
        type="button"
        data-mission-node
        data-mission-id={mission.id}
        aria-controls={`panel-${mission.id}`}
        aria-expanded={index === 0 ? 'true' : 'false'}
      >
        <span class="mission-node__icon" aria-hidden="true">
          {mission.id === 'leadership' && (
            <svg viewBox="0 0 24 24">
              <path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM4 20v-2a4 4 0 0 1 4-4h.4M20 20v-2a4 4 0 0 0-4-4h-.4M9 20v-2a3 3 0 0 1 6 0v2" />
            </svg>
          )}
          {mission.id === 'product' && (
            <svg viewBox="0 0 24 24">
              <path d="m9 18-6-6 6-6M15 6l6 6-6 6" />
            </svg>
          )}
          {mission.id === 'career-sites' && (
            <svg viewBox="0 0 24 24">
              <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM3 12h18M12 3c2.4 2.6 3.6 5.6 3.6 9S14.4 18.4 12 21M12 3c-2.4 2.6-3.6 5.6-3.6 9s1.2 6.4 3.6 9" />
            </svg>
          )}
          {mission.id === 'automation' && (
            <svg viewBox="0 0 24 24">
              <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" />
              <circle cx="12" cy="12" r="4" />
            </svg>
          )}
          {mission.id === 'frontend' && (
            <svg viewBox="0 0 24 24">
              <path d="M4 5h16v11H4zM8 20h8M10 16v4M14 16v4" />
            </svg>
          )}
        </span>
        <span class="mission-node__copy">
          <strong>{mission.title}</strong>
          <small>{mission.label}</small>
        </span>
        <span class="mission-node__arrow" aria-hidden="true">/</span>
      </button>
    ))}
  </div>

  <aside class="mission-console" aria-label={labels.consoleTitle}>
    <div class="mission-console__chrome">
      <span>{labels.consoleTitle}</span>
      <i></i><i></i><i></i>
    </div>
    <p data-console-command>{hero.consoleCommand}</p>
    <strong data-console-output aria-live="polite" aria-atomic="true">{hero.role}</strong>
    <p>rt@mission-control:~$ <span aria-hidden="true"></span></p>
  </aside>
  <a class="hero-scroll" href="#experience"><span>{lang === 'en' ? 'Explore the timeline' : 'Explorar trayectoria'}</span><span aria-hidden="true">↓</span></a>
</section>
