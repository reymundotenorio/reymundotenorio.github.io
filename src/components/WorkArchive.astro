---
import type { ArchiveFilter, ArchiveItem, Lang } from '../data/site';

interface Props {
  lang: Lang;
  filters: ArchiveFilter[];
  items: ArchiveItem[];
  title: string;
  intro: string;
  viewCase: string;
}

const { lang, filters, items, title, intro, viewCase } = Astro.props;
---

<section class="work-archive" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <span>// projects</span>
    <h2 id="work-title">{title}</h2>
    <p>{intro}</p>
  </div>

  <div class="archive-filters" aria-label="Work filters">
    {filters.map((filter) => (
      <button
        type="button"
        data-archive-filter
        data-filter={filter.id}
        class:list={[filter.id === 'all' && 'is-active']}
      >
        {filter.label}
      </button>
    ))}
  </div>

  <div class="archive-grid">
    {items.map((item, index) => (
      <article
        class="archive-item"
        data-archive-item
        data-category={item.category}
      >
        <span class="archive-item__index">{String(index + 1).padStart(2, '0')}</span>
        <span class="archive-item__source">{item.source[lang]}</span>
        <span class="archive-item__year">{item.year}</span>
        <h3>{item.name}</h3>
        <p>{item.summary[lang]}</p>
        <ul>
          {item.details[lang].map((detail) => <li>{detail}</li>)}
        </ul>
        <div class="archive-item__stack">
          {item.stack.map((stackItem) => <span>{stackItem}</span>)}
        </div>
        {item.url && (
          <a class="archive-item__cta" href={item.url} target="_blank" rel="noreferrer">
            {viewCase}
          </a>
        )}
      </article>
    ))}
  </div>
</section>
