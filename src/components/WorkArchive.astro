---
import type { ArchiveFilter, ArchiveItem, Lang } from '../data/site';
import CareerArchive from './CareerArchive.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
  filters: ArchiveFilter[];
  items: ArchiveItem[];
  title: string;
  intro: string;
  viewCase: string;
}

const { lang, filters, items, title, intro, viewCase } = Astro.props;
const featured = items.filter((item) => item.featured);
const archive = items.filter((item) => !item.featured);
---

<section class="work-archive" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <span>02 / {lang === 'en' ? 'Selected work' : 'Trabajo seleccionado'}</span>
    <h2 id="work-title">{title}</h2>
    <p>{intro}</p>
  </div>

  <div class="archive-filters" role="group" aria-label={lang === 'en' ? 'Project filters' : 'Filtros de proyectos'}>
    {filters.map((filter) => (
      <button
        type="button"
        data-archive-filter
        data-filter={filter.id}
        aria-pressed={filter.id === 'all' ? 'true' : 'false'}
        class:list={[filter.id === 'all' && 'is-active']}
      >
        {filter.label}
      </button>
    ))}
  </div>
  <p class="sr-only" data-archive-status aria-live="polite" aria-atomic="true"></p>

  <div class="archive-grid" data-archive-group>
    {featured.map((item, index) => <ProjectCard item={item} index={index} lang={lang} viewCase={viewCase} />)}
  </div>

  <details class="archive-more" data-archive-group data-archive-more>
    <summary>{lang === 'en' ? 'Client work & early projects' : 'Clientes y primeros proyectos'}<span data-archive-count>{archive.length}</span></summary>
    <div class="archive-grid">
      {archive.map((item, index) => <ProjectCard item={item} index={index + featured.length} lang={lang} viewCase={viewCase} />)}
    </div>
  </details>

  <CareerArchive lang={lang} />
</section>
