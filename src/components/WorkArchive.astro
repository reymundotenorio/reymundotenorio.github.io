---
import type { ArchiveFilter, ArchiveItem, Lang } from '../data/site';
import CareerArchive from './CareerArchive.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
  filters: ArchiveFilter[];
  items: ArchiveItem[];
  title: string;
  intro: string;
  viewCase: string;
}

const { lang, filters, items, title, intro, viewCase } = Astro.props;
const websites = items.filter((item) => item.kind === 'website');
const featured = websites.filter((item) => item.featured);
const moreWebsites = websites.filter((item) => !item.featured);
const applications = items.filter((item) => item.kind === 'application');
const archive = items.filter((item) => !['website', 'application'].includes(item.kind ?? 'archive'));
const projectIndex = (item: ArchiveItem) => items.indexOf(item);
---

<section class="work-archive" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <span>02 / {lang === 'en' ? 'Selected work' : 'Trabajo seleccionado'}</span>
    <h2 id="work-title">{title}</h2>
    <p>{intro}</p>
  </div>

  <div class="archive-filters" role="group" aria-label={lang === 'en' ? 'Project filters' : 'Filtros de proyectos'}>
    {filters.map((filter) => (
      <button
        type="button"
        data-archive-filter
        data-filter={filter.id}
        aria-pressed={filter.id === 'all' ? 'true' : 'false'}
        class:list={[filter.id === 'all' && 'is-active']}
      >
        {filter.label}
      </button>
    ))}
  </div>
  <p class="sr-only" data-archive-status aria-live="polite" aria-atomic="true"></p>

  <div class="work-group" data-archive-group>
  <h3 class="work-group__title">{lang === 'en' ? 'Selected websites' : 'Websites seleccionados'}<span data-archive-count>{featured.length}</span></h3>
  <div class="archive-grid">
    {featured.map((item) => <ProjectCard item={item} index={projectIndex(item)} lang={lang} viewCase={viewCase} />)}
  </div>
  </div>

  <details class="archive-more work-group" data-archive-group data-archive-more>
    <summary>{lang === 'en' ? 'More websites & contributions' : 'Más websites y contribuciones'}<span data-archive-count>{moreWebsites.length}</span></summary>
    <div class="archive-grid">
      {moreWebsites.map((item) => <ProjectCard item={item} index={projectIndex(item)} lang={lang} viewCase={viewCase} />)}
    </div>
  </details>

  <div class="work-group" data-archive-group>
    <h3 class="work-group__title">{lang === 'en' ? 'Apps, platforms & tools' : 'Apps, plataformas y herramientas'}<span data-archive-count>{applications.length}</span></h3>
    <div class="archive-grid">
      {applications.map((item) => <ProjectCard item={item} index={projectIndex(item)} lang={lang} viewCase={viewCase} />)}
    </div>
  </div>

  <details class="archive-more work-group" data-archive-group data-archive-more>
    <summary>{lang === 'en' ? 'Earlier work & project archive' : 'Primeros proyectos y archivo'}<span data-archive-count>{archive.length}</span></summary>
    <div class="archive-grid">
      {archive.map((item) => <ProjectCard item={item} index={projectIndex(item)} lang={lang} viewCase={viewCase} />)}
    </div>
  </details>

  <CareerArchive lang={lang} />
</section>
