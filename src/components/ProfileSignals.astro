---
import type { ProfileFact, ProfileSignalContent } from '../data/site';

interface Props {
  content: ProfileSignalContent;
}

const { content } = Astro.props;

function factMeta(fact: ProfileFact): string {
  return fact.detail ? `${fact.meta} / ${fact.detail}` : fact.meta;
}
---

<section class="profile-signals" id="signals" aria-labelledby="signals-title">
  <div class="section-heading">
    <span>{content.eyebrow}</span>
    <h2 id="signals-title">{content.title}</h2>
    <p>{content.intro}</p>
  </div>

  <div class="signals-layout">
    <article class="signal-panel signal-panel--skills">
      <div class="signal-panel__heading">
        <span>01</span>
        <h3>{content.skillsTitle}</h3>
      </div>
      <div class="skill-matrix">
        {content.skillGroups.map((group) => (
          <section class="skill-group">
            <h4>{group.title}</h4>
            <div>
              {group.items.map((item) => <span>{item}</span>)}
            </div>
          </section>
        ))}
      </div>
    </article>

    <article class="signal-panel">
      <div class="signal-panel__heading">
        <span>02</span>
        <h3>{content.certificationsTitle}</h3>
      </div>
      <ol class="signal-list">
        {content.certifications.map((fact) => (
          <li>
            <strong>{fact.title}</strong>
            <span>{factMeta(fact)}</span>
          </li>
        ))}
      </ol>
    </article>

    <article class="signal-panel">
      <div class="signal-panel__heading">
        <span>03</span>
        <h3>{content.awardsTitle}</h3>
      </div>
      <ol class="signal-list signal-list--compact">
        {content.awards.map((fact) => (
          <li>
            <strong>{fact.title}</strong>
            <span>{factMeta(fact)}</span>
          </li>
        ))}
      </ol>
    </article>

    <aside class="signal-sidebar">
      <section>
        <h3>{content.educationTitle}</h3>
        {content.education.map((fact) => (
          <p><strong>{fact.title}</strong><span>{fact.meta}</span></p>
        ))}
      </section>
      <section>
        <h3>{content.coursesTitle}</h3>
        {content.courses.map((fact) => (
          <p><strong>{fact.title}</strong><span>{fact.meta}</span></p>
        ))}
      </section>
      <section>
        <h3>{content.languagesTitle}</h3>
        {content.languages.map((fact) => (
          <p><strong>{fact.title}</strong><span>{fact.meta}</span></p>
        ))}
      </section>
    </aside>
  </div>
</section>
