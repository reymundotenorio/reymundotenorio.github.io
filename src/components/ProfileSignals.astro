---
import { siteMeta, type Lang, type ProfileFact, type ProfileSignalContent } from '../data/site';

interface Props {
  lang: Lang;
  content: ProfileSignalContent;
}

const { lang, content } = Astro.props;
const featuredAwards = [1, 11, 12, 15];
const featured = featuredAwards.map((index) => content.awards[index]);
const otherAwards = content.awards.filter((_, index) => !featuredAwards.includes(index));

function factMeta(fact: ProfileFact): string {
  return fact.detail ? `${fact.meta} · ${fact.detail}` : fact.meta;
}
---

<section class="profile-signals" id="signals" aria-labelledby="signals-title">
  <div class="section-heading">
    <span>{content.eyebrow}</span>
    <h2 id="signals-title">{content.title}</h2>
    <p>{content.intro}</p>
  </div>

  <div class="signals-layout">
    <article class="signal-panel signal-panel--skills">
      <div class="signal-panel__heading">
        <span>01</span>
        <h3>{content.skillsTitle}</h3>
      </div>
      <div class="skill-matrix">
        {content.skillGroups.map((group) => (
          <section class="skill-group">
            <h4>{group.title}</h4>
            <div>
              {group.items.map((item) => <span>{item}</span>)}
            </div>
          </section>
        ))}
      </div>
    </article>

    <article class="signal-panel">
      <div class="signal-panel__heading">
        <span>02</span>
        <h3>{content.certificationsTitle}</h3>
      </div>
      <ol class="signal-list">
        {content.certifications.slice(0, 4).map((fact) => (
          <li data-certification>
            <strong>{fact.title}</strong>
            <span>{factMeta(fact)}</span>
            {fact.url && <a class="credential-link" data-credential-link href={fact.url} target="_blank" rel="noreferrer" aria-label={`${lang === 'en' ? 'View diploma' : 'Ver diploma'}: ${fact.title}`}>{lang === 'en' ? 'View diploma' : 'Ver diploma'}<span aria-hidden="true">↗</span></a>}
          </li>
        ))}
      </ol>
      <details class="signal-disclosure">
        <summary>{lang === 'en' ? 'All certifications' : 'Todas las certificaciones'}<span>{content.certifications.length}</span></summary>
        <ol class="signal-list" start="5">
          {content.certifications.slice(4).map((fact) => <li data-certification><strong>{fact.title}</strong><span>{factMeta(fact)}</span></li>)}
        </ol>
      </details>
      <a class="credential-link" href={`${siteMeta.linkedin}details/certifications/`} target="_blank" rel="noreferrer">{lang === 'en' ? 'Latest credentials on LinkedIn' : 'Últimas credenciales en LinkedIn'}<span aria-hidden="true">↗</span></a>
    </article>

    <article class="signal-panel">
      <div class="signal-panel__heading">
        <span>03</span>
        <h3>{content.awardsTitle}</h3>
      </div>
      <ol class="signal-list">
        {featured.map((fact) => (
          <li>
            <strong>{fact.title}</strong>
            <span>{factMeta(fact)}</span>
          </li>
        ))}
      </ol>
      <details class="signal-disclosure">
        <summary>{lang === 'en' ? 'All recognition' : 'Todos los reconocimientos'}<span>{content.awards.length}</span></summary>
        <ol class="signal-list" start="5">
          {otherAwards.map((fact) => <li><strong>{fact.title}</strong><span>{factMeta(fact)}</span></li>)}
        </ol>
      </details>
    </article>

    <aside class="signal-sidebar">
      <section>
        <h3>{content.educationTitle}</h3>
        {content.education.map((fact) => (
          <p><strong>{fact.title}</strong><span>{fact.meta}</span></p>
        ))}
      </section>
      <section>
        <h3>{content.coursesTitle}</h3>
        {content.courses.map((fact) => (
          <p><strong>{fact.title}</strong><span>{fact.meta}</span></p>
        ))}
      </section>
      <section>
        <h3>{content.languagesTitle}</h3>
        {content.languages.map((fact) => (
          <p><strong>{fact.title}</strong><span>{fact.meta}</span></p>
        ))}
      </section>
    </aside>
  </div>
</section>
