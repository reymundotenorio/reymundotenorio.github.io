---
import type{GetStaticPaths}from'astro';
import corpus from'../../../data/profile.json';
import type{Data,Lang,Project}from'../../../types';
import Layout from'../../../components/Layout.astro';
import Icon from'../../../components/Icon.astro';
import ProjectImage from'../../../components/ProjectImage.astro';
export const getStaticPaths=(()=>['en','es'].flatMap(language=>{const lang=language as Lang;return(corpus[lang] as Data).projects.map(project=>({params:{lang,slug:project.id},props:{lang,project}}));}))satisfies GetStaticPaths;
interface Props{lang:Lang;project:Project}
const{lang,project}=Astro.props,en=lang==='en';
const name=project.id==='studio-ivl'?'IVL Collective':project.name;
const first=project.media[0];
const codeLink=project.url&&new URL(project.url).hostname==='github.com';
---
<Layout lang={lang} projectSlug={project.id} title={name} description={project.summary} image={first.src}>
 <main class="project-case" id="main-content" tabindex="-1" data-project-case={project.id}>
  <div class="case-topline"><a class="text-link" href={`/${lang}/#archive`} data-project-back><Icon name="arrow-up" turn="left"/>{en?'Back to projects':'Volver a proyectos'}</a>{project.year&&<span>{project.year}</span>}</div>
  <header class="case-intro"><h1>{name}</h1><p class="case-summary">{project.summary}</p><div class="case-meta">{project.contribution&&<p><span>{en?'My contribution':'Mi aporte'}</span>{project.contribution}</p>}{project.url&&<a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">{codeLink?(en?'Source code':'Código fuente'):(en?'Open website':'Abrir sitio web')}<Icon name="arrow-up-right"/></a>}</div></header>
  <figure class="case-cover"><a href={first.src} target="_blank" rel="noopener noreferrer" aria-label={en?'Open full image':'Abrir imagen completa'}><ProjectImage media={first} loading="eager" priority/></a><figcaption>{first.label}</figcaption></figure>
  <section class="case-scope" aria-labelledby="case-scope-title"><div><h2 id="case-scope-title">{en?'Scope & implementation':'Alcance e implementación'}</h2><ul>{project.details.map(detail=><li>{detail}</li>)}</ul></div>{project.stack.length>0&&<div><h2>{en?'Built with':'Tecnologías'}</h2><ul class="case-stack">{project.stack.map(item=><li>{item}</li>)}</ul></div>}</section>
  {project.media.length>1&&<section class="case-gallery" aria-labelledby="case-gallery-title"><h2 id="case-gallery-title">{en?'More views':'Más capturas'}</h2><div>{project.media.slice(1).map(media=><figure><a href={media.src} target="_blank" rel="noopener noreferrer"><ProjectImage media={media} sizes="(min-width:768px) 45vw, 92vw"/></a><figcaption>{media.label}</figcaption></figure>)}</div></section>}
  <a class="text-link case-bottom-back" href={`/${lang}/#archive`} data-project-back><Icon name="arrow-up" turn="left"/>{en?'Back to projects':'Volver a proyectos'}</a>
 </main>
 <footer class="site-footer"><span>© {new Date().getFullYear()} Reymundo Tenorio</span><a href={`/${lang}/#contact`}>{en?'Contact':'Contacto'}<Icon name="arrow-up-right"/></a></footer>
</Layout>
