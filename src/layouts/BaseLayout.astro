---
import '../styles/global.css';
import { siteMeta } from '../data/site';

interface Props {
  lang: 'en' | 'es';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050607" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={pageUrl.toString()} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).toString()} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.toString()} />
    <meta property="og:image" content={new URL(siteMeta.ogImage, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body data-lang={lang}>
    <slot />
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
