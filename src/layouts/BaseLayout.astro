---
import '../styles/global.css';
import { siteMeta } from '../data/site';

interface Props {
  lang: 'en' | 'es';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const pageUrl = new URL(Astro.url.pathname === '/' ? '/en/' : Astro.url.pathname, Astro.site);
const ogImageUrl = siteMeta.ogImage ? new URL(siteMeta.ogImage, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Reymundo Tenorio" />
    <meta name="theme-color" content="#050607" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={pageUrl.toString()} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).toString()} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.toString()} />
    <meta property="og:site_name" content="Reymundo Tenorio" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_NI'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content="Reymundo Tenorio · Engineering Manager + Full-stack Product Engineer" />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: pageUrl.toString(),
      inLanguage: lang,
      mainEntity: {
        '@type': 'Person',
        name: 'Reymundo Tenorio',
        url: Astro.site?.toString(),
        jobTitle: 'Engineering Manager + Full-stack Product Engineer',
        sameAs: [siteMeta.linkedin, siteMeta.github]
      }
    })} />
    <title>{title}</title>
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to content' : 'Ir al contenido'}</a>
    <slot />
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
